--- base6/RuHit-master/client/src/components/AngleClockVisual.tsx	1970-01-01 00:00:00.000000000 +0000
+++ ruhit/RuHit-master/client/src/components/AngleClockVisual.tsx	2026-11-16 04:02:19.914618359 +0000
@@ -0,0 +1,76 @@
+import { angleTurn, clockTimes } from '../lib/learning/visual-guard'
+import type { LearningQuestion } from '../lib/learning/types'
+
+type Point = [number, number]
+const TURN_NAMES = ['seperempat', 'setengah', 'tiga perempat', 'satu']
+
+/** Titik pada jarak tertentu dari pusat; 0 derajat = arah jam 12, searah jarum jam. */
+const polar = (cx: number, cy: number, degrees: number, length: number): Point => [cx + length * Math.sin((degrees * Math.PI) / 180), cy - length * Math.cos((degrees * Math.PI) / 180)]
+const points = (list: Point[]) => list.map((point) => `${point[0].toFixed(1)},${point[1].toFixed(1)}`).join(' ')
+
+/** Lingkaran empat bagian sama besar; sejumlah `turn` bagian diarsir dari jam 12 searah jarum jam. Derajatnya tidak ditulis (itu jawabannya). */
+export function AngleVisual({ question }: { question: LearningQuestion }) {
+  const turn = angleTurn(question)
+  if (turn === null) return null
+  const cx = 150
+  const cy = 100
+  const radius = 70
+  const steps = turn * 12
+  const arc = Array.from({ length: steps + 1 }, (_, index) => polar(cx, cy, (index / steps) * turn * 90, radius))
+  const spokes = [0, 90, 180, 270].map((degrees) => polar(cx, cy, degrees, radius))
+  return (
+    <svg className="geometry-visual" viewBox="0 0 300 200" role="img" aria-label={`Lingkaran dibagi empat bagian sama besar; ${TURN_NAMES[turn - 1]} putaran diarsir dari jam 12 searah jarum jam`}>
+      <circle className="geo-cell" cx={cx} cy={cy} r={radius} />
+      <polygon className="geo-shape" points={points([[cx, cy], ...arc])} />
+      <g className="geo-grid">{spokes.map((spoke, index) => <line key={index} x1={cx} y1={cy} x2={spoke[0]} y2={spoke[1]} />)}</g>
+      <line className="geo-edge" x1={cx} y1={cy} x2={arc[0][0]} y2={arc[0][1]} />
+      <line className="geo-edge" x1={cx} y1={cy} x2={arc[steps][0]} y2={arc[steps][1]} />
+    </svg>
+  )
+}
+
+const format = (minutes: number) => `${String(Math.floor(minutes / 60)).padStart(2, '0')}.${String(minutes % 60).padStart(2, '0')}`
+
+function Clock({ cx, minutes, name }: { cx: number; minutes: number; name: string }) {
+  const cy = 72
+  const radius = 56
+  const total = ((minutes % 1440) + 1440) % 1440
+  const hour = Math.floor(total / 60)
+  const minute = total % 60
+  const hourTip = polar(cx, cy, ((hour % 12) + minute / 60) * 30, 20)
+  const minuteTip = polar(cx, cy, minute * 6, 29)
+  return (
+    <g className="geo-clock">
+      <circle className="geo-cell" cx={cx} cy={cy} r={radius} />
+      <g className="geo-grid">
+        {[30, 60, 120, 150, 210, 240, 300, 330].map((degrees) => {
+          const outer = polar(cx, cy, degrees, radius - 3)
+          const inner = polar(cx, cy, degrees, radius - 9)
+          return <line key={degrees} x1={outer[0]} y1={outer[1]} x2={inner[0]} y2={inner[1]} />
+        })}
+      </g>
+      {([[12, 0], [3, 90], [6, 180], [9, 270]] as const).map(([numeral, degrees]) => {
+        const at = polar(cx, cy, degrees, 41)
+        return <text className="geo-label" key={numeral} x={at[0]} y={at[1]} textAnchor="middle" dominantBaseline="middle">{numeral}</text>
+      })}
+      <line className="geo-hand-h" x1={cx} y1={cy} x2={hourTip[0]} y2={hourTip[1]} />
+      <line className="geo-hand-m" x1={cx} y1={cy} x2={minuteTip[0]} y2={minuteTip[1]} />
+      <circle className="geo-player" cx={cx} cy={cy} r={4} />
+      <text className="geo-label geo-name" x={cx} y={142} textAnchor="middle" dominantBaseline="middle">{name}</text>
+      <text className="geo-label geo-time" x={cx} y={164} textAnchor="middle" dominantBaseline="middle">{format(total)}</text>
+    </g>
+  )
+}
+
+/** Dua jam analog: waktu berangkat dan tiba. Lama perjalanan tidak digambar. */
+export function ClockVisual({ question }: { question: LearningQuestion }) {
+  const times = clockTimes(question)
+  if (!times) return null
+  return (
+    <svg className="geometry-visual" viewBox="0 0 300 176" role="img" aria-label={`Jam berangkat pukul ${format(times.start)} dan jam tiba pukul ${format(times.end)}`}>
+      <Clock cx={75} minutes={times.start} name="Berangkat" />
+      <text className="geo-label" x={150} y={72} textAnchor="middle" dominantBaseline="middle">→</text>
+      <Clock cx={225} minutes={times.end} name="Tiba" />
+    </svg>
+  )
+}
diff -ruN base6/RuHit-master/client/src/components/SolidVisual.tsx ruhit/RuHit-master/client/src/components/SolidVisual.tsx
--- base6/RuHit-master/client/src/components/SolidVisual.tsx	1970-01-01 00:00:00.000000000 +0000
+++ ruhit/RuHit-master/client/src/components/SolidVisual.tsx	2026-11-16 04:02:40.224011455 +0000
@@ -0,0 +1,59 @@
+import type { ReactElement } from 'react'
+import { describeSolid } from '../lib/learning/visual-guard'
+import type { LearningQuestion } from '../lib/learning/types'
+
+type Point = [number, number]
+const COS30 = Math.cos(Math.PI / 6)
+const points = (list: Point[]) => list.map((point) => `${point[0].toFixed(1)},${point[1].toFixed(1)}`).join(' ')
+
+/**
+ * Balok/kubus dalam proyeksi isometrik. x (panjang) ke kanan-bawah, y (lebar) ke kiri-bawah, z (tinggi) ke atas.
+ * cubes = true: kisi kubus satuan di tiga sisi yang terlihat dan label ukuran (bahan soal), tanpa jumlah kubusnya.
+ * cubes = false: bangun polos; tiga rusuk yang tersembunyi digambar putus-putus supaya semua titik sudut terlihat.
+ */
+export function SolidVisual({ question }: { question: LearningQuestion }) {
+  const solid = describeSolid(question)
+  if (!solid) return null
+  const { length: L, width: W, height: H, cubes } = solid
+  const spanX = (L + W) * COS30
+  const spanY = (L + W) / 2 + H
+  const scale = Math.min((cubes ? 118 : 190) / spanX, (cubes ? 112 : 150) / spanY)
+  const ox = 150 - ((L - W) * COS30 * scale) / 2
+  const oy = (cubes ? 88 : 100) - (((L + W) / 2 - H) / 2) * scale
+  const at = (x: number, y: number, z: number): Point => [ox + (x - y) * COS30 * scale, oy + ((x + y) / 2 - z) * scale]
+  const line = (key: string, a: Point, b: Point, className?: string) => <line key={key} className={className} x1={a[0]} y1={a[1]} x2={b[0]} y2={b[1]} />
+
+  const grid: ReactElement[] = []
+  if (cubes) {
+    for (let i = 1; i < L; i += 1) { grid.push(line(`tx${i}`, at(i, 0, H), at(i, W, H))); grid.push(line(`lx${i}`, at(i, W, 0), at(i, W, H))) }
+    for (let j = 1; j < W; j += 1) { grid.push(line(`ty${j}`, at(0, j, H), at(L, j, H))); grid.push(line(`ry${j}`, at(L, j, 0), at(L, j, H))) }
+    for (let k = 1; k < H; k += 1) { grid.push(line(`rz${k}`, at(L, 0, k), at(L, W, k))); grid.push(line(`lz${k}`, at(0, W, k), at(L, W, k))) }
+  }
+  const name = L === W && W === H ? 'kubus' : 'balok'
+  const label = cubes ? `Balok dari kubus satuan: panjang ${L}, lebar ${W}, tinggi ${H}` : `Gambar ${name}`
+  const lengthAt = at(L / 2, W, 0)
+  const widthAt = at(L, W / 2, 0)
+  const heightAt = at(0, W, H / 2)
+  return (
+    <svg className="geometry-visual" viewBox="0 0 300 200" role="img" aria-label={label}>
+      {!cubes && (
+        <g>
+          {line('h1', at(0, 0, 0), at(L, 0, 0), 'geo-dash')}
+          {line('h2', at(0, 0, 0), at(0, W, 0), 'geo-dash')}
+          {line('h3', at(0, 0, 0), at(0, 0, H), 'geo-dash')}
+        </g>
+      )}
+      <polygon className="geo-shape geo-face-top" points={points([at(0, 0, H), at(L, 0, H), at(L, W, H), at(0, W, H)])} />
+      <polygon className="geo-shape geo-face-right" points={points([at(L, 0, 0), at(L, W, 0), at(L, W, H), at(L, 0, H)])} />
+      <polygon className="geo-shape" points={points([at(0, W, 0), at(L, W, 0), at(L, W, H), at(0, W, H)])} />
+      {cubes && <g className="geo-grid">{grid}</g>}
+      {cubes && (
+        <g>
+          <text className="geo-label" x={lengthAt[0] - 9} y={lengthAt[1] + 16} textAnchor="middle" dominantBaseline="middle">{`panjang ${L}`}</text>
+          <text className="geo-label" x={widthAt[0] + 9} y={widthAt[1] + 16} textAnchor="middle" dominantBaseline="middle">{`lebar ${W}`}</text>
+          <text className="geo-label" x={heightAt[0] - 10} y={heightAt[1]} textAnchor="end" dominantBaseline="middle">{`tinggi ${H}`}</text>
+        </g>
+      )}
+    </svg>
+  )
+}
