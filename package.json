{
  "name": "ruang-hitung",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@10.4.1",
  "scripts": {
    "dev": "node scripts/generate-routes.mjs && vite --host",
    "build": "node scripts/generate-routes.mjs && vite build && node scripts/build-service-worker.mjs",
    "preview": "vite preview --host",
    "check": "tsc --noEmit",
    "test": "vitest run && node scripts/verify-static.mjs",
    "verify:static": "node scripts/verify-static.mjs",
    "format": "prettier --write client/src docs scripts package.json vite.config.ts",
    "audit": "pnpm audit --prod",
    "audit:soal": "vitest run --config vitest.audit.config.ts"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource-variable/fraunces": "5.3.0",
    "lucide-react": "0.453.0",
    "react": "19.2.1",
    "react-dom": "19.2.1"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.7.0",
    "@types/react": "19.2.1",
    "@types/react-dom": "19.2.1",
    "@vitejs/plugin-react": "5.0.4",
    "jsdom": "26.1.0",
    "prettier": "3.6.2",
    "typescript": "5.6.3",
    "vite": "7.1.9",
    "vitest": "2.1.9"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
